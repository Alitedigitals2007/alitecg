<%- include('partials/footer') %>
<script>
(function(){
  var task=document.querySelector('input[value="TASK"]'),pay=document.querySelector('input[value="PAYMENT"]');
  var ft=document.querySelector('.proof-task'),fp=document.querySelector('.proof-pay');
  function upd(){var t=task.checked;ft.style.display=t?'':'none';fp.style.display=t?'none':'';ft.querySelector('input').required=t;fp.querySelector('input').required=!t;}
  [task,pay].forEach(function(r){r.addEventListener('change',upd);});upd();
  var form=document.querySelector('form[action="/submit"]');
  form.addEventListener('submit',async function(e){
    e.preventDefault();
    if(typeof DataTransfer==='undefined'){form.submit();return;}
    var inputs=(task.checked?ft:fp).querySelectorAll('input[type="file"]');
    var dt=new DataTransfer(),total=0,n=0;
    for(var inp of inputs){
      for(var f of inp.files){
        var out=f;
        try{
          if(f.type.indexOf('image/')===0){
            var img=await createImageBitmap(f);
            var s=Math.min(1,1080/Math.max(img.width,img.height));
            var c=document.createElement('canvas');
            c.width=Math.round(img.width*s);c.height=Math.round(img.height*s);
            c.getContext('2d').drawImage(img,0,0,c.width,c.height);
            var b=await new Promise(function(r){c.toBlob(r,'image/jpeg',0.75);});
            if(b&&b.size<f.size)out=new File([b],f.name.replace(/\.\w+$/,'')+'.jpg',{type:'image/jpeg'});
          }
        }catch(err){}
        total+=out.size;n++;
        if(inp.multiple){if(n<=10)dt.items.add(out);}else if(dt.files.length===0)dt.items.add(out);
      }
    }
    if(n===0){alert('Please choose your '+(task.checked?'task screenshots':'payment receipt')+' first.');return;}
    if(total>4*1024*1024){alert('Your images are still too large after compression. Please use fewer or smaller screenshots.');return;}
    for(var i2 of inputs)i2.files=dt.files;
    form.submit();
  });
})();
</script>
