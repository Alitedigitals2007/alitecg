<%- include('partials/header', { title: 'VCF orders' }) %><section class="admin-page"><a href="/admin?key=<%= key %>" class="back">← Contact gain queue</a><div class="admin-head"><div><p class="eyebrow">PRIVATE WORKSPACE</p><h1>VCF orders (₦1,500)</h1></div><div class="admin-actions"><a class="button outline" href="/admin?key=<%= key %>">Contact gain queue</a><a class="button outline" href="/admin/settings?key=<%= key %>">Settings</a></div></div><div class="table-wrap"><table><thead><tr><th>Order code</th><th>Buyer</th><th>Status</th><th>Submitted</th><th></th></tr></thead><tbody><% users.forEach(u => { %><tr><td><b><%= u.uniqueCode %></b></td><td><strong><%= u.fullName %></strong><small><%= u.phoneNumber %></small></td><td><span class="pill <%= u.status.toLowerCase() %>"><%= u.status %></span></td><td><%= new Date(u.createdAt).toLocaleDateString() %></td><td><a href="/admin/verify/<%= u.uniqueCode %>?key=<%= key %>">Review →</a></td></tr><% }) %></tbody></table></div></section><%- include('partials/footer') %>
