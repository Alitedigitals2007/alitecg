<%- include('partials/header', { title: 'Check submission status' }) %><section class="status-page"><p class="eyebrow">TRACK YOUR SUBMISSION</p><h1>Where does your<br><em>contact stand?</em></h1><p class="lede">Enter the unique code you received or your WhatsApp number.</p><form class="search" id="status-form"><input name="query" required placeholder="ALC-89214 or phone number"><button class="button primary">Search ↗</button></form><div id="status-result"></div></section><script>document.querySelector('#status-form').addEventListener('submit',async(e)=>{e.preventDefault();const box=document.querySelector('#status-result');box.innerHTML='<p class="muted">Searching...</p>';const r=await fetch('/api/search',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({query:e.target.query.value})});const d=await r.json();if(!r.ok){box.innerHTML='<div class="result error">'+d.error+'</div>';return}const u=d.user;const text={PENDING:'Your verification is currently under review by admin.',APPROVED:'Congratulations! Your contact has been verified and added to the VCF download batch.',REJECTED:'Your submission needs attention. Reason: '+u.rejectionReason}[u.status];box.innerHTML='<div class="result '+u.status.toLowerCase()+'"><b>'+u.status+'</b><p>'+text+'</p>'+(u.status==='REJECTED'?'<a class="button outline" href="https://wa.me/2349154681851?text='+encodeURIComponent('Hello Admin, I would like to appeal tracking code '+u.uniqueCode)+ '" target="_blank">Message Admin for appeal ↗</a>':'')+'</div>'});</script><%- include('partials/footer') %>
