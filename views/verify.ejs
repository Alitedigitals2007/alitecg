<%- include('partials/header', { title: 'Review submission' }) %><section class="verify-page"><a href="/admin?key=<%= key %>" class="back">← Submission queue</a><div class="verify-grid"><div><p class="eyebrow">REVIEW <%= user.uniqueCode %></p><h1><%= user.fullName %></h1><div class="details"><p><small>SCHOOL</small><b><%= user.school %></b></p><p><small>WHATSAPP</small><b><%= user.phoneNumber %></b></p><p><small>TYPE</small><b><%= user.submissionTypeLabel %></b></p><p><small>SUBMITTED</small><b><%= new Date(user.createdAt).toLocaleString() %></b></p></div><div class="actions"><form action="/admin/approve/<%= user.uniqueCode %>?key=<%= key %>" method="post"><input type="hidden" name="adminKey" value="<%= key %>"><button class="button approve">Accept submission ✓</button></form><form action="/admin/reject/<%= user.uniqueCode %>?key=<%= key %>" method="post"><input type="hidden" name="adminKey" value="<%= key %>"><label>Rejection reason<input name="reason" required placeholder="e.g. Invalid proof image"></label><button class="button reject">Reject submission</button></form></div></div><div class="proof"><p class="eyebrow">UPLOADED PROOF<% if (user.proofCount > 1) { %> · <%= user.proofCount %> IMAGES<% } %></p><% for (let i = 0; i < user.proofCount; i++) { %><img src="/proof/<%= user.uniqueCode %>?i=<%= i %>&key=<%= key %>" alt="Proof <%= i + 1 %> for <%= user.fullName %>"><% } %></div></div></section><%- include('partials/footer') %>
