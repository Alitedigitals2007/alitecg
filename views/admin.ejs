<%- include('partials/header', { title: 'Admin dashboard' }) %><section class="admin-page"><div class="admin-head"><div><p class="eyebrow">PRIVATE WORKSPACE</p><h1>Contact gain queue</h1></div><div class="admin-actions"><a class="button outline" href="/admin/vcf?key=<%= key %>">VCF orders</a><a class="button outline" href="/admin/settings?key=<%= key %>">Settings</a><a class="button outline" href="/download/vcf?key=<%= key %>">Download VCF ↗</a></div></div><div class="table-wrap"><table><thead><tr><th>Tracking code</th><th>Contact</th><th>Type</th><th>Status</th><th>Submitted</th><th></th></tr></thead><tbody><% users.forEach(u => { %><tr><td><b><%= u.uniqueCode %></b></td><td><strong><%= u.fullName %></strong><small><%= u.phoneNumber %> · <%= u.school %></small></td><td><%= u.submissionTypeLabel %></td><td><span class="pill <%= u.status.toLowerCase() %>"><%= u.status %></span></td><td><%= new Date(u.createdAt).toLocaleDateString() %></td><td><a href="/admin/verify/<%= u.uniqueCode %>?key=<%= key %>">Review →</a></td></tr><% }) %></tbody></table></div></section><%- include('partials/footer') %>
