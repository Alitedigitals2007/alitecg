<%- include('partials/header', { title: 'Admin settings' }) %><section class="admin-page"><a href="/admin?key=<%= key %>" class="back">← Submission queue</a><div class="admin-head"><div><p class="eyebrow">PRIVATE WORKSPACE</p><h1>Settings</h1></div></div><% if (saved) { %><div class="result approved"><b>SAVED</b><p>Settings updated successfully.</p></div><% } %><div class="panel"><form action="/admin/settings?key=<%= key %>" method="post"><input type="hidden" name="adminKey" value="<%= key %>"><div class="form-grid"><label>WhatsApp Channel link<input name="channelLink" required value="<%= settings.channel_link %>"></label><label>WhatsApp Group link<input name="groupLink" required value="<%= settings.group_link %>"></label></div><button class="button primary" type="submit">Save settings</button></form></div></section><%- include('partials/footer') %>
